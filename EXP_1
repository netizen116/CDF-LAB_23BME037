import csv
import math
from pathlib import Path

import numpy as np
import matplotlib.pyplot as plt

# Simulation parameters
NX, NY = 120, 60
RE, ALPHA = 100, 10
STEPS, P_STEPS = 300, 80
LX, LY = 5.0, 2.5
U0, C, X0 = 1.0, 1.0, 1.6

OUT = Path("airfoil_result_5deg")


def thickness(x):
    x = np.clip(x, 0, 1)
    return 0.6 * (
        0.2969*np.sqrt(x) - 0.1260*x - 0.3516*x**2
        + 0.2843*x**3 - 0.1036*x**4
    )


def get_airfoil(angle, n=401):
    t = np.linspace(0, np.pi, n)
    xc = (1 - np.cos(t)) / 2
    yt = thickness(xc)

    xb = np.r_[xc[::-1], xc[1:]]
    yb = np.r_[-yt[::-1], yt[1:]]

    a = np.radians(angle)
    xq = X0 + C/4
    xr = xb*C - C/4

    return (xq + np.cos(a)*xr - np.sin(a)*yb*C,
            np.sin(a)*xr + np.cos(a)*yb*C)


def make_mask(x, y):
    a = np.radians(ALPHA)
    xq = X0 + C/4

    xr = (np.cos(a)*(x-xq) + np.sin(a)*y + C/4) / C
    yr = (-np.sin(a)*(x-xq) + np.cos(a)*y) / C

    return (xr >= 0) & (xr <= 1) & (np.abs(yr) <= thickness(xr))


def ghost_nodes(s):
    g = np.zeros_like(s)
    g[1:] |= s[1:] & ~s[:-1]
    g[:-1] |= s[:-1] & ~s[1:]
    g[:, 1:] |= s[:, 1:] & ~s[:, :-1]
    g[:, :-1] |= s[:, :-1] & ~s[:, 1:]
    return g


def set_ghost(f, s, g, wall=0, noslip=False):
    old = f.copy()

    for j, i in np.argwhere(g):
        for jj, ii in ((j, i-1), (j, i+1),
                       (j-1, i), (j+1, i)):
            if 0 <= jj < f.shape[0] and 0 <= ii < f.shape[1]:
                if not s[jj, ii]:
                    f[j, i] = (2*wall-old[jj, ii]
                               if noslip else old[jj, ii])
                    break

    f[s & ~g] = wall
    return f


def derivative(f, h, axis=1, upwind=None):
    if upwind is None:
        return (np.roll(f, -1, axis)-np.roll(f, 1, axis))/(2*h)

    forward = (np.roll(f, -1, axis)-f)/h
    backward = (f-np.roll(f, 1, axis))/h
    return np.where(upwind >= 0, backward, forward)


def lap(f, dx, dy):
    return (
        (np.roll(f, -1, 1)-2*f+np.roll(f, 1, 1))/dx**2
        + (np.roll(f, -1, 0)-2*f+np.roll(f, 1, 0))/dy**2
    )


def bc(u, v, p, solid, ghost):
    u[:, 0], v[:, 0] = U0, 0
    u[:, -1], v[:, -1] = u[:, -2], v[:, -2]

    u[[0, -1], :], v[[0, -1], :] = U0, 0

    p[:, 0], p[:, -1] = p[:, 1], 0
    p[0, :], p[-1, :] = p[1, :], p[-2, :]

    set_ghost(u, solid, ghost, noslip=True)
    set_ghost(v, solid, ghost, noslip=True)
    set_ghost(p, solid, ghost)


def poisson(rhs, dx, dy, solid, ghost):
    phi = np.zeros_like(rhs)
    ax, ay = 1/dx**2, 1/dy**2
    den = 2*(ax+ay)
    fluid = ~solid

    for _ in range(P_STEPS):
        old = phi.copy()
        val = (
            ax*(old[1:-1, 2:]+old[1:-1, :-2])
            + ay*(old[2:, 1:-1]+old[:-2, 1:-1])
            - rhs[1:-1, 1:-1]
        ) / den

        phi[1:-1, 1:-1][fluid[1:-1, 1:-1]] = (
            val[fluid[1:-1, 1:-1]]
        )

        phi[:, 0], phi[:, -1] = phi[:, 1], 0
        phi[0, :], phi[-1, :] = phi[1, :], phi[-2, :]
        set_ghost(phi, solid, ghost)

    return phi


def main():
    OUT.mkdir(exist_ok=True)

    xv = np.linspace(0, LX, NX)
    yv = np.linspace(-LY/2, LY/2, NY)
    x, y = np.meshgrid(xv, yv)

    dx, dy = xv[1]-xv[0], yv[1]-yv[0]
    nu = U0*C/RE

    solid = make_mask(x, y)
    ghost = ghost_nodes(solid)

    u = np.full((NY, NX), U0)
    v = np.zeros_like(u)
    p = np.zeros_like(u)

    bc(u, v, p, solid, ghost)

    dt = min(0.20*min(dx, dy)/U0,
             0.15*min(dx**2, dy**2)/nu)

    history = []

    for step in range(1, STEPS+1):
        a, b = u.copy(), v.copy()

        du = (-a*derivative(a, dx, 1, a)
              -b*derivative(a, dy, 0, b) + nu*lap(a, dx, dy))

        dv = (-a*derivative(b, dx, 1, a)
              -b*derivative(b, dy, 0, b) + nu*lap(b, dx, dy))

        us, vs = a+dt*du, b+dt*dv
        bc(us, vs, p, solid, ghost)

        rhs = (derivative(us, dx, 1)
               + derivative(vs, dy, 0))/dt
        rhs[solid] = 0

        phi = poisson(rhs, dx, dy, solid, ghost)

        u = us-dt*derivative(phi, dx, 1)
        v = vs-dt*derivative(phi, dy, 0)

        p += phi
        p[solid & ~ghost] = 0

        bc(u, v, p, solid, ghost)

        div = derivative(u, dx, 1)+derivative(v, dy, 0)
        continuity = np.sqrt(np.mean(div[~solid]**2))
        speed = np.sqrt(u**2+v**2)
        vmax = np.max(speed[~solid])

        history.append([step, step*dt, continuity, vmax])

        if not all(np.isfinite(f).all() for f in (u, v, p)):
            raise FloatingPointError("Invalid solution detected")

        if vmax > 25:
            raise FloatingPointError("Simulation diverged")

        if step == 1 or step % 60 == 0 or step == STEPS:
            print(f"Step {step}: Continuity={continuity:.4e}, "
                  f"Max speed={vmax:.4f}")

    speed = np.sqrt(u**2+v**2)
    vort = derivative(v, dx, 1)-derivative(u, dy, 0)

    with open(OUT/"history.csv", "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["iteration", "pseudo_time",
                         "continuity", "max_speed"])
        writer.writerows(history)

    np.savez(OUT/"airfoil_fields.npz",
             x=x, y=y, u=u, v=v, p=p, speed=speed,
             vorticity=vort, solid=solid, ghost=ghost)

    wx, wy = get_airfoil(ALPHA)

    fig, ax = plt.subplots(1, 3, figsize=(16, 4.5))

    ax[0].semilogy(np.array(history)[:, 0],
                   np.maximum(np.array(history)[:, 2], 1e-14))
    ax[0].set(title="Continuity", xlabel="Iteration",
              ylabel="L2 divergence")
    ax[0].grid()

    for axis, field, title, label in (
        (ax[1], speed, "Velocity magnitude", "Speed"),
        (ax[2], vort, "Vorticity", "Vorticity")
    ):
        plot = axis.contourf(x, y, field, levels=30)
        axis.plot(wx, wy, "k-", linewidth=1.2)
        fig.colorbar(plot, ax=axis, label=label)
        axis.set(title=title, xlabel="x", ylabel="y",
                 xlim=(0.5, 4), ylim=(-1, 1))
        axis.set_aspect("equal")

    fig.tight_layout()
    fig.savefig(OUT/"results.png", dpi=150)
    plt.show()

    print("Final continuity:", history[-1][2])
    print("Saved results to:", OUT.resolve())


if __name__ == "__main__":
    main()
